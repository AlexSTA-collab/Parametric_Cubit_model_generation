*node
** Our  nodes
**
*include, input=angle_0/height_0.01/include_nodes.inp
********************************** E L E M E N T S ****************************
*element, type=C3D8, provider=edelweiss, elset=bottom-body
*include, input=angle_0/height_0.01/include_elset_bottom.inp

*element, type=C3D8, provider=edelweiss, elset=interface-body
*include, input=angle_0/height_0.01/include_elset_interface.inp

*element, type=C3D8, provider=edelweiss, elset=top-body
*include, input=angle_0/height_0.01/include_elset_top.inp

********************************** N O D E S E T S **********************************
*NSET, NSET=bottom-Z+
*include, input=angle_0/height_0.01/include_nset_bottom-Z+.inp
*NSET, NSET=bottom-Y+
*include, input=angle_0/height_0.01/include_nset_bottom-Y+.inp
*NSET, NSET=bottom-X+
*include, input=angle_0/height_0.01/include_nset_bottom-X+.inp
*NSET, NSET=bottom-Z-
*include, input=angle_0/height_0.01/include_nset_bottom-Z-.inp
*NSET, NSET=bottom-Y-
*include, input=angle_0/height_0.01/include_nset_bottom-Y-.inp
*NSET, NSET=bottom-X-
*include, input=angle_0/height_0.01/include_nset_bottom-X-.inp
*NSET, NSET=top-Z-
*include, input=angle_0/height_0.01/include_nset_top-Z-.inp
*NSET, NSET=top-Y+
*include, input=angle_0/height_0.01/include_nset_top-Y+.inp
*NSET, NSET=top-X-
*include, input=angle_0/height_0.01/include_nset_top-X-.inp
*NSET, NSET=top-Z+
*include, input=angle_0/height_0.01/include_nset_top-Z+.inp
*NSET, NSET=top-Y-
*include, input=angle_0/height_0.01/include_nset_top-Y-.inp
*NSET, NSET=top-X+
*include, input=angle_0/height_0.01/include_nset_top-X+.inp

*material, name=LinearElastic, id=linearelastic_body_1, provider=edelweissmaterial
**Isotropic
**$E_M    nu
1.0, 0.3

*material, name=LinearElastic, id=linearelastic_body_2, provider=edelweissmaterial
**Isotropic
**$E_I    nu
1.0, 0.3

*material, name=LinearElastic, id=interface_body, provider = edelweissmaterial
 **Isotropic
**$E_0   nu
1.0, 0.3

*section, name=section1, material=linearelastic_body_2, type=solid
bottom-body

*section, name=section2, material=linearelastic_body_1, type=solid
top-body

*section, name=section3, material=interface_body, type=solid
interface-body

*job, name=Fulljob, domain=3d
*solver, solver=NIST, name=theSolver

*fieldOutput
create=perNode, elSet=top-body, field=displacement, result=U, name=displacement_top
create=perNode, elSet=top-body, field=displacement, result=P, name=reaction_top
create=perNode, elSet=bottom-body, field=displacement, result=U, name=displacement_bottom
create=perNode, elSet=bottom-body, field=displacement, result=P, name=reaction_bottom
create=perNode, elSet=interface-body, field=displacement, result=U, name=displacement_interface
create=perElement, elSet=top-body, quadraturePoint=0:8, result=stress , name=stress_top, f(x)='np.mean(x,axis=1)' 
create=perElement, elSet=bottom-body, quadraturePoint=0:8, result=stress , name=stress_bottom, f(x)='np.mean(x,axis=1)' 
create=perElement, elSet=interface-body, quadraturePoint=0:8, result=stress , name=stress_interface, f(x)='np.mean(x,axis=1)' 

*output, type=ensight, name=Cohesive_zone_model_interface
create=perNode, fieldOutput=displacement_interface
create=perElement, fieldOutput=stress_interface
configuration, overwrite=yes

*output, type=ensight, name=Cohesive_zone_model_top
create=perNode, fieldOutput=displacement_top
create=perNode,  fieldOutput=reaction_top
create=perElement, fieldOutput=stress_top
configuration, overwrite=yes

*output, type=ensight, name=Cohesive_zone_model_bottom
create=perNode,  fieldOutput=displacement_bottom
create=perNode,  fieldOutput=reaction_bottom
create=perElement, fieldOutput=stress_bottom
configuration, overwrite=yes

*step, solver=theSolver, maxInc=1, minInc=1, maxNumInc=1000, maxIter=1000, stepLength=1e-8
options, category=NISTSolver, extrapolation=off
dirichlet, name = bottom,   nSet = bottom-Z-,  field=displacement, 1=-0.1, 2=0, 3=0, f(t)=t
dirichlet, name = top,      nSet = top-Z+,  field=displacement, 1=0.1, 2=0, 3=0, f(t)=t

*step, solver=theSolver, maxInc=0.025, minInc=0.025, maxNumInc=1000, maxIter=1000, stepLength= 0.1
options, category=NISTSolver, extrapolation=off
dirichlet, name = bottom,   nSet = bottom-Z-,  field=displacement, 1=-0.1, 2=0, 3=0, f(t)=1
dirichlet, name = top,      nSet = top-Z+,  field=displacement, 1=0.1, 2=0, 3=0, f(t)=1
